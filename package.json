{
  "name": "listino-smartphones-security-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-listino-smartphones \"mocha --timeout 10000 tests/firestore.rules.test.js\"",
