rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return userExists() && userData().active == true;
    }
    function isAdmin() {
      return activeUser() && userData().role == 'admin';
    }
    function isSeller() {
      return activeUser() && userData().role == 'seller';
    }
function sellerOwnsShop(shopId) {
      return isSeller() && userData().shopId == shopId;
    }
    function clientShopId() {
      return signedIn() && request.auth.token.role == 'client'
        ? request.auth.token.shopId
        : null;
    }
    function isClient() {
      return signedIn() &&
        request.auth.token.role == 'client' &&
        request.auth.token.sid != null &&
        clientShopId() != null &&
        exists(/databases/$(database)/documents/clientSessions/$(request.auth.token.sid)) &&
        exists(/databases/$(database)/documents/shopAccess/$(clientShopId())) &&
        get(/databases/$(database)/documents/clientSessions/$(request.auth.token.sid)).data.active == true &&
        get(/databases/$(database)/documents/clientSessions/$(request.auth.token.sid)).data.shopId == clientShopId() &&
        request.time < get(/databases/$(database)/documents/clientSessions/$(request.auth.token.sid)).data.expiresAt &&
        get(/databases/$(database)/documents/shopAccess/$(clientShopId())).data.active == true &&
        get(/databases/$(database)/documents/clientSessions/$(request.auth.token.sid)).data.sessionVersion ==
          get(/databases/$(database)/documents/shopAccess/$(clientShopId())).data.sessionVersion;
    }
    function canReadCatalog() {
      return isAdmin() || isSeller() || isClient();
    }

    match /users/{userId} {
      // Ogni utente autenticato può leggere esclusivamente il proprio profilo.
      // L'applicazione controlla active e role dopo la lettura.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Il dipendente può soltanto completare il cambio password obbligatorio.
      // Ruolo, negozio, stato e ogni altro campo restano non modificabili dal client.
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'seller' &&
        resource.data.active == true &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mustChangePassword', 'updatedAt']) &&
        request.resource.data.mustChangePassword == false;
      allow create, delete: if false;
    }

    match /shops/{shopId} {
      // Il cliente QR può leggere soltanto il negozio associato al proprio token.
      allow get: if isAdmin() || isSeller() ||
        (isClient() && clientShopId() == shopId);
      allow list: if isAdmin() || isSeller();
      allow write: if isAdmin();
    }

    function clientCanReadDevice(deviceId) {
      return isClient() &&
        clientShopId() != null &&
        exists(/databases/$(database)/documents/shopCatalog/$(clientShopId())) &&
        deviceId in get(/databases/$(database)/documents/shopCatalog/$(clientShopId())).data.enabledDeviceIds;
    }

    match /devices/{deviceId} {
      allow get: if isAdmin() || isSeller() || clientCanReadDevice(deviceId);
      allow list: if isAdmin() || isSeller();
      allow write: if isAdmin();
    }

    // Le schede tecniche non contengono quantità di magazzino né offerte commerciali.
    // Il catalogo delle varianti resta comunque filtrato da clientCanReadDevice.
    match /deviceModels/{modelId} {
      allow read: if canReadCatalog();
      allow write: if isAdmin();
    }

    match /shopCatalog/{shopId} {
      allow get, list: if isAdmin() ||
        sellerOwnsShop(shopId) ||
        (isClient() && clientShopId() == shopId);
      allow create, update: if isAdmin() || sellerOwnsShop(shopId);
      allow delete: if isAdmin();
    }

    match /stock/{stockId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isAdmin() || (settingId == 'catalog' && canReadCatalog());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /stockVersions/{versionId}/items/{stockId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}