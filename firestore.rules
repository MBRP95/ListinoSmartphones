rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return userExists() && userData().active == true;
    }
    function isAdmin() {
      return activeUser() && userData().role == 'admin';
    }
    function isSeller() {
      return activeUser() && userData().role == 'seller';
    }
    function isClient() {
      return activeUser() && userData().role == 'client';
    }
    function canReadAppData() {
      return isAdmin() || isSeller() || isClient();
    }

    match /users/{userId} {
      allow get: if activeUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /shops/{shopId} {
      allow read: if canReadAppData();
      allow write: if isAdmin();
    }
    match /devices/{deviceId} {
      allow read: if canReadAppData();
      allow write: if isAdmin();
    }
    match /stock/{stockId} {
      allow read: if canReadAppData();
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if canReadAppData();
      allow write: if isAdmin();
    }
    match /stockVersions/{versionId}/items/{stockId} {
      allow read: if canReadAppData();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}